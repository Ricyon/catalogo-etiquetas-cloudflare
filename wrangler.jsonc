{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalogo-etiquetas-cloudflare",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "vars": {
    "GOOGLE_SHEET_ID": "1z8Rl_iuWxS2r2Oq1dQG1Na7g4XGcWfZH",
    "GOOGLE_SHEET_GID": "1966383603",
    "GOOGLE_SHEET_NAME": "Base Materiais",
    "GOOGLE_SHEET_FALLBACK_NAME": "Base etiquetas",
    "CATALOG_CACHE_SECONDS": "120"
  }
}
